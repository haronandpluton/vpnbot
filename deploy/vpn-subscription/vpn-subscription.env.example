LOG_LEVEL=INFO

# The Python service must listen only on loopback. Nginx owns public 80/443.
VPN_SUBSCRIPTION_BIND_HOST=127.0.0.1
VPN_SUBSCRIPTION_BIND_PORT=2097
VPN_SUBSCRIPTION_META_FILE=/opt/vpn-subscription/subscriptions_meta.json

# Public South Africa gateway used by Happ subscription links.
VPN_SUBSCRIPTION_PUBLIC_BASE_URL=https://connect.presentvpn.click

# Existing European VPN node. Change these only when the Xray inbound changes.
VPN_UPSTREAM_HOST=eu1.presentvpn.click
VPN_UPSTREAM_PORT=443
VPN_UPSTREAM_WS_PATH=/ws-test
VPN_UPSTREAM_WS_HOST=eu1.presentvpn.click
VPN_UPSTREAM_SNI=eu1.presentvpn.click

# Optional multi-node list. Leave empty to keep the legacy single-node settings
# above. A node appears in Happ/v2RayTun only after the same subscription UUID
# has been provisioned on that node.
# VPN_SUBSCRIPTION_NODES_JSON='[{"name":"🇩🇪 Frankfurt","host":"eu1.presentvpn.click","port":443,"ws_path":"/ws-test","ws_host":"eu1.presentvpn.click","sni":"eu1.presentvpn.click"},{"name":"🇳🇱 Netherlands","host":"nl1.presentvpn.click","port":443,"ws_path":"/ws-test","ws_host":"nl1.presentvpn.click","sni":"nl1.presentvpn.click"}]'

# Subscription profile branding
VPN_SUBSCRIPTION_PROFILE_TITLE=PRESENT VPN 🎁
VPN_SUBSCRIPTION_SERVER_NAME=🇩🇪 Frankfurt
VPN_SUBSCRIPTION_TELEGRAM_URL=https://t.me/PRESENT_VPN_BOT
VPN_SUBSCRIPTION_PROFILE_WEB_PAGE_URL=
VPN_SUBSCRIPTION_ACTIVE_ANNOUNCE_TEMPLATE=Manage subscription • {telegram} • Days left: {days_left}
VPN_SUBSCRIPTION_EXPIRED_ANNOUNCE_TEMPLATE=Subscription expired on {expires_at} • Renew via {telegram}
# Happ advanced subscription banner
# Provider ID is production-specific and stays empty in repository.
VPN_SUBSCRIPTION_HAPP_PROVIDER_ID=
VPN_SUBSCRIPTION_HAPP_INFO_COLOR=blue
VPN_SUBSCRIPTION_HAPP_INFO_TEMPLATE=Manage subscription | {telegram} | Days left: {days_left} | Expires: {expires_at}
VPN_SUBSCRIPTION_HAPP_INFO_BUTTON_TEXT=Telegram bot
